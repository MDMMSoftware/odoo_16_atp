<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>

		<!-- Wizard Form Daily Income Report-->
		<record id="view_form_cash_flow_diff_wizard" model="ir.ui.view">
			<field name="name">Cash Flow Diff Wizard</field>
			<field name="model">cash.flow.diff</field>
			<field name="arch" type="xml">
				<form>
					<group name="group-top">
						<group name="group-left">
                            <field name="target_year"/>
							<field name="target_month"/>
							<field name="journal_ids"  widget="many2many_tags"  invisible="1"/>
						</group>
						<group name="group-right">
							<field name="no_of_comparison" />
							<field name="entry_options"/>
						</group>
					</group>
					<footer>
						<button string="Print Report" type="object" class="btn-info" name="export_cash_flow"/>
						<button string="Cancel" special="cancel"/>
					</footer>
				</form>
			</field>
		</record>


		<!--- Wizard Action For Daily Income Report -->
		<record id="cash_flow_diff_wizard" model="ir.actions.act_window">
			<field name="name">Cash Flow Diff Wizard</field>
			<field name="res_model">cash.flow.diff</field>
			<field name="type">ir.actions.act_window</field>
			<field name="view_mode">form</field>
            <field name="view_id" ref="view_form_cash_flow_diff_wizard"/>
			<field name="target">new</field>
		</record>
		
        
		<menuitem id="menu_cash_flow_diff_wizard" name="Cash Flow Difference" parent="account.account_reports_legal_statements_menu" action="cash_flow_diff_wizard" sequence="2" />      

	</data>
</odoo>