<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_account_group_report_tree" model="ir.ui.view">
            <field name="name">account.group.report.tree</field>
            <field name="model">account.group.report</field>
            <field name="arch" type="xml">
                <tree string="Account Group Report">
                    <field name="name"  />
                    <field name="account_ids"  widget="many2many_tags" />
                </tree>
            </field>
        </record>

        <record id="view_account_group_report_form" model="ir.ui.view">
            <field name="name">account.group.report.form</field>
            <field name="model">account.group.report</field>
            <field name="arch" type="xml">
                <form string="Account Group Report">
                    <sheet>
                        <group>
                            <group>
                                <field name="name" required="1" />
                            </group>
                            <group>
                                <field name="account_ids"  widget="many2many_tags" required="1"/>
                            </group>                            
                        </group>
                    </sheet>
                </form>
            </field>
        </record>        

        <record id="view_account_group_report_action" model="ir.actions.act_window">
            <field name="name">Account Group Report Action</field>
            <field name="res_model">account.group.report</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_account_group_report_tree"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                Create an account group action.
                </p><p>
                An account group is a set of datas that groups the accounts for the reporting.
                </p>            
            </field>
        </record>    

        <menuitem id="menu_action_group_report" name="Account Groups Reports" action="view_account_group_report_action" parent="account.account_account_menu"/>      

    </data>
</odoo>