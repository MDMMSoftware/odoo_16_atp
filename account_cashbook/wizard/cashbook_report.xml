<?xml version="1.0" encoding="utf-8"?>
<odoo>

   <record id="cashbook_xlsx_report_view" model="ir.ui.view">
       <field name="name">Cashbook xlsx Report</field>
       <field name="model">cashbook.report</field>
       <field name="arch" type="xml">
           <form string="Report Options">
               <group col="2">
                    <group>
                        <field name="start_date" required="1" string="Date"/>
                        <!-- <field name="company_id" widget="many2many_tags" required="1"/> -->
                        <field name="entry_type" required="1"/>
                        <!-- <field name="report_type"/> -->
                    </group>
                    <group>
                        <!-- <field name="end_date"/> -->
                        <field name="report_type" required="1"/>                        
                        <!-- <field name="branch_ids" widget="many2many_tags"/> -->
                        <field name="account_id" attrs="{'invisible':[('report_type','=','account_group_report')], 'required': [('report_type', '=', 'coa')]}"/>
                        <field name="account_group_report_id"  attrs="{'invisible':[('report_type','=','coa')], 'required': [('report_type', '=', 'account_group_report')]}" />
                    </group>
               </group>
               <footer>
                   <button name="download_cash_report_excel" string="Download Cash Report" type="object" default_focus="1" class="oe_highlight btn btn-info"/>
                   <button string="Cancel" class="btn btn-default" special="cancel"/>
               </footer>
           </form>
       </field>
   </record>

   <record id="action_cashbook_xlsx_report" model="ir.actions.act_window">
       <field name="name">Cashbook Report</field>
       <field name="res_model">cashbook.report</field>
       <field name="type">ir.actions.act_window</field>
       <field name="view_mode">form</field>
       <field name="target">new</field>
   </record>

    <record id="export_cash_report_xlsx" model="ir.actions.report">
        <field name="name">Cash Report</field>
        <field name="model">cashbook.report</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">account_cashbook.export_cash_report_xls</field>
        <field name="report_file">account_cashbook.export_cash_report_xls</field>
        <field name="binding_type">report</field>
    </record>   

   <menuitem id="cashbook_xlsx_report" name="Cashbook Report" parent="account_cashbook.menu_cashbook" action="action_cashbook_xlsx_report" sequence="8"/>
</odoo>